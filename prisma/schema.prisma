generator client {
  provider = "prisma-client-js"
}

datasource db {
  // We use postgresql as requested for Vercel Postgres. 
  // You need to set DATABASE_URL in your .env file to run migrations.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}
